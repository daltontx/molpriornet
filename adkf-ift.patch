+    parser.add_argument(
+        "--adkf-batch-size",
+        type=int,
+        default=320,
+        help=(
+            "Maximum batch size for the ADKF DKT batcher. Automatically raised"
+            " if support+query exceeds this."
+        ),
+    )
+    parser.add_argument(
+        "--out",
+        type=str,
+        default=None,
+        help="Optional path to write a CSV of the timings.",
+    )
+    return parser.parse_args(argv)
+
+
+def main() -> None:
+    args = parse_args()
+    run_comparison(args)
+
+
+if __name__ == "__main__":
+    main()
