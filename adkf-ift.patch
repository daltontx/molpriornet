diff --git a/fs_mol/aggregate_results.py b/fs_mol/aggregate_results.py
new file mode 100644
index 0000000..53017ef
--- /dev/null
+++ b/fs_mol/aggregate_results.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Aggregate FS-Mol per-task evaluation CSVs into a summary table.
+
+Works for both numeric (regression) and binary (classification) outputs --
+everything after the 'seed' column is treated as a metric to aggregate.
+
+The reported uncertainty is the *seed-induced* standard deviation of the
+headline number: for each support size and metric, average across tasks
+within each seed (giving one value per seed), then take the std across seeds.
+This answers "how much would the headline change if we re-ran the whole
+pipeline with a fresh set of seeds?", which is the relevant noise floor when
+comparing models on a benchmark of intrinsically heterogeneous tasks (and
+where task-level variability is shared across all methods anyway -- see
+``pairwise_compare.py`` for proper paired model comparisons).
+
+The original FS-Mol-style cross-task std is still reported as a secondary
+column (``task_std``) for sanity-checking and continuity with prior work.
+
+To make the per-seed cross-task means comparable, only tasks that have
+results for *all* seeds at a given support size contribute to that row.
+
+Usage:
+    python fs_mol/aggregate_results.py outputs/FSMol_Eval_KernelMPN_2026-03-31_11-46-52/
+"""
+import argparse
+import glob
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+
+
+def load_results(results_dir):
+    """Load and concatenate all per-task CSVs, tagging each with the task name."""
+    csv_paths = sorted(glob.glob(os.path.join(results_dir, "*_eval_results.csv")))
+    if not csv_paths:
+        print(f"No *_eval_results.csv files found in {results_dir}", file=sys.stderr)
+        sys.exit(1)
+
+    frames = []
+    for path in csv_paths:
+        task_name = os.path.basename(path).replace("_eval_results.csv", "")
+        df = pd.read_csv(path)
+        df.insert(0, "task", task_name)
+        frames.append(df)
+
+    return pd.concat(frames, ignore_index=True)
+
+
+def aggregate(df):
+    """Compute, per (num_train_requested, metric):
+
+      - mean: grand mean over the (task, seed) grid
+      - seed_std: std across seeds of (per-seed cross-task mean)
+                  -- captures seed-induced variability of the headline
+      - task_std: std across tasks of (per-task cross-seed mean)
+                  -- the original FS-Mol-style cross-task std (secondary)
+      - n_tasks, n_seeds: sample sizes backing each std
+
+    Only tasks with full seed coverage at the given support size contribute.
+    """
+    seed_col_idx = list(df.columns).index("seed")
+    metric_cols = list(df.columns[seed_col_idx + 1 :])
+
+    rows = []
+    for train_size, sub in df.groupby("num_train_requested", sort=True):
+        seeds_per_task = sub.groupby("task")["seed"].nunique()
+        max_seeds = int(seeds_per_task.max())
+        complete_tasks = seeds_per_task[seeds_per_task == max_seeds].index
+        dropped = sorted(set(seeds_per_task.index) - set(complete_tasks))
+        if dropped:
+            preview = ", ".join(dropped[:3]) + (", ..." if len(dropped) > 3 else "")
+            print(
+                f"  [warn] num_train_requested={int(train_size)}: dropping "
+                f"{len(dropped)} task(s) without full seed coverage "
+                f"({max_seeds} seeds expected): {preview}",
+                file=sys.stderr,
+            )
+
+        sub_complete = sub[sub["task"].isin(complete_tasks)]
+        n_tasks = int(sub_complete["task"].nunique())
+        n_seeds = int(sub_complete["seed"].nunique())
+
+        out = {
+            "num_train_requested": int(train_size),
+            "n_tasks": n_tasks,
+            "n_seeds": n_seeds,
+        }
+
+        for col in metric_cols:
+            # tasks x seeds matrix; .mean() collapses any duplicate (task, seed)
+            # rows defensively (shouldn't happen in normal eval runs).
+            cell = (
+                sub_complete.groupby(["task", "seed"])[col]
+                .mean()
+                .unstack("seed")
+            )
+            per_seed_mean = cell.mean(axis=0)  # one value per seed
+            per_task_mean = cell.mean(axis=1)  # one value per task
+
+            out[f"{col}_mean"] = per_seed_mean.mean()
+            out[f"{col}_seed_std"] = (
+                per_seed_mean.std(ddof=1) if n_seeds > 1 else np.nan
+            )
+            out[f"{col}_task_std"] = (
+                per_task_mean.std(ddof=1) if n_tasks > 1 else np.nan
+            )
+
+        rows.append(out)
+
+    return pd.DataFrame(rows), metric_cols
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Aggregate FS-Mol evaluation results across tasks and seeds.",
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
+    )
+    parser.add_argument(
+        "results_dir",
+        type=str,
+        help="Directory containing *_eval_results.csv files from an eval run.",
+    )
+    parser.add_argument(
+        "--out",
+        type=str,
+        default=None,
+        help="Path to write the summary CSV. If omitted, only prints to stdout.",
+    )
+    args = parser.parse_args()
+
+    df = load_results(args.results_dir)
+    formatted, metric_cols = aggregate(df)
+
+    print(f"\nResults from: {args.results_dir}")
+    print(f"Tasks: {df['task'].nunique()}, Metric columns: {metric_cols}\n")
+
+    for _, row in formatted.iterrows():
+        print(
+            f"  num_train = {int(row['num_train_requested']):>4d}  "
+            f"(n_tasks={int(row['n_tasks'])}, n_seeds={int(row['n_seeds'])})"
+        )
+        for col in metric_cols:
+            mean = row[f"{col}_mean"]
+            seed_std = row[f"{col}_seed_std"]
+            task_std = row[f"{col}_task_std"]
+            seed_str = f"{seed_std:.4f}" if pd.notna(seed_std) else "  n/a "
+            task_str = f"{task_std:.4f}" if pd.notna(task_std) else "  n/a "
+            print(
+                f"    {col:>30s}:  {mean:.4f}"
+                f"  ± {seed_str} (seed)"
+                f"   [± {task_str} (task)]"
+            )
+        print()
+
+    if args.out:
+        formatted.to_csv(args.out, index=False)
+        print(f"Summary written to {args.out}")
+
+
+if __name__ == "__main__":
+    main()
