new file mode 100644
index 0000000..4855991
--- /dev/null
+++ b/fs_mol/mpn_test.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Evaluate Molecular Prior Network models on FS-Mol tasks.
+
+Requires the ``molpriornet`` package alongside the FS-Mol dependencies:
+
+    pip install git+https://github.com/daltontx/molpriornet.git
+"""
+import argparse
+import logging
+import sys
+
+import numpy as np
+import torch
+from dpu_utils.utils import run_and_debug
+from pyprojroot import here as project_root
+
+sys.path.insert(0, str(project_root()))
+
+from molpriornet.model import AttMPN
+from molpriornet.utils import MODEL_CLASSES, get_fingerprint_size
+
+from fs_mol.data.fsmol_task import FSMolTaskSample
+from fs_mol.utils.chem_utils import compute_fingerprints
+from fs_mol.utils.metrics import NumericEvalMetrics, compute_numeric_task_metrics
+from fs_mol.utils.test_utils import (
+    eval_model,
+    add_eval_cli_args,
+    set_up_test_run,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def test(model, task_sample, fp_size):
+    train_data = task_sample.train_samples
+    test_data = task_sample.test_samples
+
+    X_train = compute_fingerprints([x.smiles for x in train_data], fp_size)
+    X_test = compute_fingerprints([x.smiles for x in test_data], fp_size)
+
+    y_train = np.array([float(x.numeric_label) for x in train_data])
+    y_test = np.array([float(x.numeric_label) for x in test_data])
+
+    logger.info(f" Evaluating {type(model).__name__} with {X_train.shape[0]} training samples.")
+
+    # Convert to pIC50 space: -log10(value_nM * 1e-9) = 9 - log10(value_nM)
+    # This is what MPN models were trained on (FSMolLoader.TargetType.LOG_REGRESSION_PROPERTY).
+    pic50_train = -np.log10(y_train * 1e-9)
+
+    # Fit/predict in pIC50 space, matching run_mpn.py conventions
+    with torch.no_grad():
+        if isinstance(model, AttMPN):
+            pic50_mean = pic50_train.mean()
+            pic50_std = pic50_train.std()
+            model.fit(X_train, (pic50_train - pic50_mean) / pic50_std)
+            preds_pic50 = model.predict(X_test) * pic50_std + pic50_mean
+        else:
+            model.fit(X_train, pic50_train)
+            preds_pic50 = model.predict(X_test)
+
+    # Convert predictions back to ADKF's ln(nM) convention for metric computation.
+    # pIC50 = 9 - log10(val_nM)  =>  ln(val_nM) = (9 - pIC50) * ln(10)
+    preds_ln = (9.0 - preds_pic50) * np.log(10)
+
+    # Standardize in ln space (matching ADKF / baseline_numeric_test protocol)
+    log_y_train = np.log(y_train)
+    log_y_test = np.log(y_test)
+    standardize_mean = log_y_train.mean()
+    standardize_std = log_y_train.std()
+
+    preds_standardized = (preds_ln - standardize_mean) / standardize_std
+    log_y_test_standardized = (log_y_test - standardize_mean) / standardize_std
+
+    test_metrics = compute_numeric_task_metrics(preds_standardized, log_y_test_standardized)
+    logger.info(f" Test metrics: {test_metrics}")
+
+    return test_metrics
+
+
+def run_from_args(args):
+    out_dir, dataset = set_up_test_run(args.model, args, torch=True)
+
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    logger.info(f"Device: {device}")
+
+    model = MODEL_CLASSES[args.model].load_model(args.TRAINED_MODEL)
+    model.eval()
+    fp_size = get_fingerprint_size(model)
+    logger.info(f"Loaded {args.model} from {args.TRAINED_MODEL} (fingerprint size: {fp_size})")
+
+    def test_model_fn(
+        task_sample: FSMolTaskSample, temp_out_folder: str, seed: int
+    ) -> NumericEvalMetrics:
+        return test(model=model, task_sample=task_sample, fp_size=fp_size)
+
+    eval_model(
+        test_model_fn=test_model_fn,
+        dataset=dataset,
+        train_set_sample_sizes=args.train_sizes,
+        out_dir=out_dir,
+        num_samples=args.num_runs,
+        test_size_or_ratio=args.test_size,
+        seed=args.seed,
+        filter_numeric_labels=True,
+    )
+
+
+def run():
+    parser = argparse.ArgumentParser(
+        description="Evaluate MPN models (AttMPN / KernelMPN) on FS-Mol tasks.",
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
+    )
+
+    parser.add_argument(
+        "TRAINED_MODEL",
+        type=str,
+        help="Path to the pretrained model checkpoint (.pth file).",
+    )
+
+    add_eval_cli_args(parser)
+
+    parser.add_argument(
+        "--model",
+        type=str,
+        default="KernelMPN",
+        choices=list(MODEL_CLASSES),
+        help="Which MPN model architecture to evaluate.",
+    )
+    parser.add_argument("--debug", dest="debug", action="store_true", help="Enable debug routines")
+
+    args = parser.parse_args()
+    run_and_debug(lambda: run_from_args(args), args.debug)
+
+
+if __name__ == "__main__":
+    run()
diff --git a/fs_mol/runtime_comparison.py b/fs_mol/runtime_comparison.py
new file mode 100644
index 0000000..3c3f52b
--- /dev/null
+++ b/fs_mol/runtime_comparison.py
@@ -0,0 +1,776 @@
+#!/usr/bin/env python3
+"""Compare wall-clock fit+predict time of ADKF-IFT, both MPN models
+(AttMPN and KernelMPN) and a Random-Forest baseline (with grid search,
+matching ``baseline_numeric_test.py``) on a single FS-Mol task, as a function
+of support-set size.
+
+Protocol
+--------
+1. Load one task from a ``.jsonl.gz`` file.
+2. Filter out tasks whose numeric labels don't match the pIC50-style
+   regression convention used by both ADKF and the MPN pipeline.
+3. Reserve a fraction of the samples as a fixed query (test) set; the rest form
+   the support pool.
+4. Pre-compute MPN Morgan fingerprints for every sample **once** per MPN model
+   (outside the timed region) so that the cost of featurisation is not charged
+   to the MPN fit+predict time. ADKF reuses the fingerprints / descriptors
+   already cached in the ``.jsonl.gz`` file. Random-Forest reuses the cached
+   ECFP fingerprint exposed by ``MoleculeDatapoint.get_fingerprint()`` (also
+   precomputed outside the timed region).
+5. Loop over support sizes ``step, 2*step, ...``. For each size, time just the
+   fit+predict portion of each model. Also record R2 on the query set as a
+   sanity check.
+
+Example
+-------
+    python fs_mol/runtime_comparison.py \
+        ../../data/fs-mol/test/CHEMBL1909140.jsonl.gz \
+        outputs/adkf_ift.pt \
+        --kernel-mpn-checkpoint outputs/kernel_mpn.pth \
+        --att-mpn-checkpoint outputs/att_mpn.pth \
+        --step 10 \
+        --query-fraction 0.3 \
+        --out runtime_comparison.csv
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import gc
+import logging
+import random
+import sys
+import time
+from functools import partial
+from typing import Any, Dict, List, Optional, Tuple
+
+import numpy as np
+import torch
+from dpu_utils.utils import RichPath
+from pyprojroot import here as project_root
+from rdkit import Chem
+from rdkit.Chem import rdFingerprintGenerator
+from sklearn.ensemble import RandomForestRegressor
+from sklearn.model_selection import GridSearchCV
+
+sys.path.insert(0, str(project_root()))
+
+from molpriornet.model import AttMPN, KernelMPN
+
+from fs_mol.data.dkt import (
+    get_dkt_batcher,
+    task_sample_to_dkt_task_sample,
+)
+from fs_mol.data.fsmol_task import FSMolTask, FSMolTaskSample, MoleculeDatapoint
+from fs_mol.models.adaptive_dkt import ADKTModel
+from fs_mol.utils.adaptive_dkt_utils import ADKTModelTrainer, run_on_batches
+from fs_mol.utils.metrics import compute_numeric_task_metrics
+from fs_mol.utils.torch_utils import torchify
+
+
+logger = logging.getLogger(__name__)
+
+# The MPN classes the script knows how to load. The keys double as short labels
+# used in CSV columns and log lines.
+MPN_MODEL_CLASSES: Dict[str, Any] = {
+    "kernel_mpn": KernelMPN,
+    "att_mpn": AttMPN,
+}
+
+# Random-Forest hyperparameter grid, lifted verbatim from
+# ``baseline_numeric_test.py`` so the timing reflects the same protocol.
+RF_GRID_SEARCH: Dict[str, List[Any]] = {
+    "n_estimators": [100, 200],
+    "max_depth": [5, 10, 20],
+    "max_features": [None, "sqrt", "log2"],
+    "min_samples_leaf": [2, 5],
+}
+
+
+# ---------------------------------------------------------------------------
+# Data helpers
+# ---------------------------------------------------------------------------
+
+def load_task(jsonl_path: str) -> FSMolTask:
+    """Load an FS-Mol task from a ``.jsonl.gz`` file."""
+    return FSMolTask.load_from_file(RichPath.create(jsonl_path))
+
+
+def task_has_valid_numeric_labels(task: FSMolTask) -> bool:
+    """Mirror the filter used in the DKT / MPN evaluation pipelines."""
+    labels = np.array([s.numeric_label for s in task.samples])
+    all_percentages = np.all(labels >= 0.0) and np.all(labels <= 100.0)
+    non_positive = np.any(labels <= 0.0)
+    has_inf = np.any(np.isinf(labels))
+    has_nan = np.any(np.isnan(labels))
+    return not (all_percentages or non_positive or has_inf or has_nan)
+
+
+def split_support_query(
+    task: FSMolTask,
+    query_fraction: float,
+    seed: int,
+    max_query_size: Optional[int] = None,
+) -> Tuple[List[MoleculeDatapoint], List[MoleculeDatapoint]]:
+    """Shuffle samples and split into (support_pool, query_set).
+
+    ``query_fraction`` is the default rule, but if ``max_query_size`` is given
+    the query set is capped at that size — useful when you want to hold the
+    query set to a fixed count (e.g. 100) while the support pool grows into
+    the thousands.
+    """
+    rng = random.Random(seed)
+    samples = list(task.samples)
+    rng.shuffle(samples)
+
+    n_query = max(2, int(round(query_fraction * len(samples))))
+    if max_query_size is not None:
+        n_query = min(n_query, max_query_size)
+    if n_query >= len(samples):
+        raise ValueError(
+            f"Query size {n_query} leaves no samples for the support pool"
+            f" (task has {len(samples)} samples)."
+        )
+    query = samples[:n_query]
+    support_pool = samples[n_query:]
+    return support_pool, query
+
+
+# ---------------------------------------------------------------------------
+# MPN helpers
+# ---------------------------------------------------------------------------
+
+def get_mpn_fingerprint_size(model) -> int:
+    if isinstance(model, AttMPN):
+        return model.n_features
+    if isinstance(model, KernelMPN):
+        return model.proj.weight.shape[1]
+    raise ValueError(f"Unknown MPN model type: {type(model)}")
+
+
+def compute_mpn_fingerprints(smiles_list: List[str], fp_size: int) -> np.ndarray:
+    """Morgan (radius=2) bit fingerprints, matching the MPN training pipeline."""
+    generator = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=fp_size)
+    fps = []
+    for smi in smiles_list:
+        mol = Chem.MolFromSmiles(smi)
+        if mol is None:
+            mol = Chem.MolFromSmiles(smi, sanitize=False)
+            mol.UpdatePropertyCache(strict=False)
+            Chem.FastFindRings(mol)
+        fps.append(np.array(generator.GetFingerprint(mol)))
+    return np.array(fps, dtype=np.float32)
+
+
+def mpn_fit_predict(
+    model,
+    X_train: torch.Tensor,
+    X_test: torch.Tensor,
+    y_train_pic50: torch.Tensor,
+) -> np.ndarray:
+    """Match the pIC50-space fit/predict convention from ``mpn_test.py``.
+
+    ``X_train`` / ``X_test`` / ``y_train_pic50`` must already live on the same
+    device as ``model``; we call ``model.forward`` directly to avoid the
+    CPU-only ``fit`` / ``predict`` helpers in the ``molpriornet`` package.
+    Returns predictions in pIC50 space as a NumPy array on CPU.
+    """
+    with torch.no_grad():
+        if isinstance(model, AttMPN):
+            # ``unbiased=False`` matches numpy's default ``ddof=0`` so the
+            # standardisation is bit-for-bit equivalent to the original numpy
+            # implementation.
+            mean = y_train_pic50.mean()
+            std = y_train_pic50.std(unbiased=False)
+            y_t = ((y_train_pic50 - mean) / std).unsqueeze(-1)
+            out = model(X_train, y_t, X_test).squeeze(-1)
+            preds = (out * std + mean).detach().cpu().numpy()
+        else:
+            out = model(X_train, y_train_pic50, X_test)
+            preds = out.detach().cpu().numpy()
+    return preds
+
+
+def mpn_predictions_to_standardized_log(
+    preds_pic50: np.ndarray,
+    y_train_nM: np.ndarray,
+) -> np.ndarray:
+    """Convert pIC50 predictions to the ADKF-style standardized log-nM space
+    so that metrics can be compared head-to-head."""
+    preds_ln = (9.0 - preds_pic50) * np.log(10)
+    log_y_train = np.log(y_train_nM)
+    mean = log_y_train.mean()
+    std = log_y_train.std()
+    return (preds_ln - mean) / std
+
+
+# ---------------------------------------------------------------------------
+# Random-Forest helpers
+# ---------------------------------------------------------------------------
+
+def rf_fit_predict(
+    X_train: np.ndarray,
+    X_test: np.ndarray,
+    y_train_std: np.ndarray,
+    grid: Dict[str, List[Any]],
+    cv: int = 5,
+    n_jobs: int = -1,
+) -> np.ndarray:
+    """Match the grid-search protocol used in ``baseline_numeric_test.py``.
+
+    ``y_train_std`` should already be in standardized log-nM space (computed
+    with the support-set's own log-mean/std), so the predictions returned here
+    can be compared directly against the equivalently standardized query
+    labels.
+    """
+    grid_search = GridSearchCV(RandomForestRegressor(), grid, n_jobs=n_jobs, cv=cv)
+    grid_search.fit(X_train, y_train_std)
+    return grid_search.best_estimator_.predict(X_test)
+
+
+# ---------------------------------------------------------------------------
+# ADKF helpers
+# ---------------------------------------------------------------------------
+
+def build_adkf_batch(
+    support_samples: List[MoleculeDatapoint],
+    query_samples: List[MoleculeDatapoint],
+    task_name: str,
+    model: ADKTModel,
+    use_numeric_labels: bool,
+    max_batch_size: int,
+):
+    """Turn a (support, query) pair into a torchified DKT batch on the model's
+    device. Runs outside the timed region."""
+    batcher = get_dkt_batcher(max_num_graphs=max_batch_size)
+    task_sample = FSMolTaskSample(
+        name=task_name,
+        train_samples=support_samples,
+        valid_samples=[],
+        test_samples=query_samples,
+    )
+    dkt_task_sample = task_sample_to_dkt_task_sample(
+        task_sample, batcher, filter_numeric_labels=use_numeric_labels
+    )
+    return torchify(dkt_task_sample, device=model.device)
+
+
+def adkf_fit_predict(model: ADKTModel, dkt_task_sample) -> float:
+    """Run ADKF's fit+predict on a single task sample. Returns test R2 as a
+    sanity-check."""
+    metrics = run_on_batches(
+        model,
+        batches=dkt_task_sample.batches,
+        batch_labels=dkt_task_sample.batch_labels,
+        batch_numeric_labels=dkt_task_sample.batch_numeric_labels,
+        train=False,
+    )
+    return metrics.r2
+
+
+# ---------------------------------------------------------------------------
+# Timing utilities
+# ---------------------------------------------------------------------------
+
+def _sync(device: torch.device) -> None:
+    if device.type == "cuda":
+        torch.cuda.synchronize(device)
+
+
+def _time_callable(
+    fn,
+    device: torch.device,
+    repeats: int,
+    warmup: int = 1,
+):
+    """Run ``fn`` ``repeats`` times after ``warmup`` discarded warm-up calls.
+
+    Returns ``(mean_s, median_s, std_s, last_return)``. The median is reported
+    alongside the mean because with only a handful of repeats a single slow
+    call (GC pause, scheduler hiccup) drags the mean well away from the typical
+    runtime. ``warmup=0`` is appropriate for expensive callables (e.g. RF grid
+    search) where there is no kernel JIT or allocator state worth amortising.
+    """
+    for _ in range(warmup):
+        fn()
+        _sync(device)
+
+    timings = []
+    last_ret = None
+    for _ in range(repeats):
+        _sync(device)
+        t0 = time.perf_counter()
+        last_ret = fn()
+        _sync(device)
+        timings.append(time.perf_counter() - t0)
+    arr = np.array(timings)
+    return float(arr.mean()), float(np.median(arr)), float(arr.std()), last_ret
+
+
+# ---------------------------------------------------------------------------
+# Main loop
+# ---------------------------------------------------------------------------
+
+def run_comparison(args):
+    logging.basicConfig(
+        level=logging.INFO,
+        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
+    )
+
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    logger.info("Device: %s", device)
+
+    # ----- Load task -----
+    task = load_task(args.data_path)
+    logger.info("Loaded task %s with %d samples.", task.name, len(task.samples))
+
+    if not task_has_valid_numeric_labels(task):
+        raise ValueError(
+            f"Task {task.name} has labels incompatible with the pIC50 regression"
+            " convention used by ADKF / MPN."
+        )
+
+    support_pool, query_samples = split_support_query(
+        task,
+        args.query_fraction,
+        args.seed,
+        max_query_size=args.max_query_size,
+    )
+    logger.info(
+        "Reserved %d samples as the fixed query set; %d available as support pool.",
+        len(query_samples),
+        len(support_pool),
+    )
+
+    # Determine support-size schedule
+    if args.support_size_schedule is not None:
+        requested = sorted(set(int(n) for n in args.support_size_schedule))
+        support_sizes = [n for n in requested if 1 <= n <= len(support_pool)]
+        dropped = [n for n in requested if n not in support_sizes]
+        if dropped:
+            logger.warning(
+                "Dropping schedule entries that exceed the support pool"
+                " (%d samples): %s",
+                len(support_pool),
+                dropped,
+            )
+        if not support_sizes:
+            raise ValueError(
+                "No valid support sizes in --support-size-schedule;"
+                f" pool size is {len(support_pool)}."
+            )
+        logger.info("Sweeping support sizes (explicit): %s", support_sizes)
+    else:
+        max_support_size = args.max_support_size or len(support_pool)
+        max_support_size = min(max_support_size, len(support_pool))
+        support_sizes = list(range(args.step, max_support_size + 1, args.step))
+        if not support_sizes:
+            raise ValueError(
+                "No valid support sizes. Increase support pool or reduce --step."
+            )
+        logger.info(
+            "Sweeping support sizes %s (step=%d).",
+            f"{support_sizes[0]}..{support_sizes[-1]}",
+            args.step,
+        )
+
+    # ----- Load MPN models + precompute fingerprints (once per model) -----
+    mpn_checkpoints: Dict[str, str] = {}
+    if args.kernel_mpn_checkpoint:
+        mpn_checkpoints["kernel_mpn"] = args.kernel_mpn_checkpoint
+    if args.att_mpn_checkpoint:
+        mpn_checkpoints["att_mpn"] = args.att_mpn_checkpoint
+
+    mpn_models: Dict[str, torch.nn.Module] = {}
+    # Each MPN model can have a different fingerprint size, so we cache one
+    # (support_pool_fps_t, query_fps_t) pair per model.
+    mpn_fp_cache: Dict[str, Tuple[torch.Tensor, torch.Tensor]] = {}
+
+    for name, ckpt in mpn_checkpoints.items():
+        cls = MPN_MODEL_CLASSES[name]
+        model = cls.load_model(ckpt).to(device)
+        model.eval()
+        fp_size = get_mpn_fingerprint_size(model)
+        logger.info(
+            "Loaded MPN %s from %s (fingerprint size: %d).",
+            name,
+            ckpt,
+            fp_size,
+        )
+
+        logger.info(
+            "Pre-computing MPN fingerprints for %s (excluded from timing)...",
+            name,
+        )
+        fp_t0 = time.perf_counter()
+        support_pool_fps = compute_mpn_fingerprints(
+            [s.smiles for s in support_pool], fp_size
+        )
+        query_fps = compute_mpn_fingerprints(
+            [s.smiles for s in query_samples], fp_size
+        )
+        logger.info(
+            "Pre-computed %d support + %d query fingerprints for %s in %.2fs.",
+            support_pool_fps.shape[0],
+            query_fps.shape[0],
+            name,
+            time.perf_counter() - fp_t0,
+        )
+
+        # Move fingerprints to device once, outside the timed region.
+        mpn_models[name] = model
+        mpn_fp_cache[name] = (
+            torch.as_tensor(support_pool_fps, device=device),
+            torch.as_tensor(query_fps, device=device),
+        )
+
+    y_support_pool_nM = np.array([float(s.numeric_label) for s in support_pool])
+    y_query_nM = np.array([float(s.numeric_label) for s in query_samples])
+
+    # Pre-compute the pIC50-space support labels on device once, so the
+    # per-call MPN timing does not include host -> device label uploads or the
+    # log10 transform (parity with ADKF, whose labels are torchified outside
+    # the timed region inside ``build_adkf_batch``).
+    y_support_pool_pic50_t = torch.as_tensor(
+        -np.log10(y_support_pool_nM * 1e-9), dtype=torch.float32, device=device
+    )
+
+    # ----- Random-Forest features (once) -----
+    rf_support_pool_X: Optional[np.ndarray] = None
+    rf_query_X: Optional[np.ndarray] = None
+    if args.rf:
+        logger.info(
+            "Pre-extracting cached ECFP fingerprints for Random Forest"
+            " (excluded from timing)..."
+        )
+        rf_t0 = time.perf_counter()
+        rf_support_pool_X = np.array([s.get_fingerprint() for s in support_pool])
+        rf_query_X = np.array([s.get_fingerprint() for s in query_samples])
+        logger.info(
+            "Extracted RF features: support %s, query %s in %.2fs.",
+            rf_support_pool_X.shape,
+            rf_query_X.shape,
+            time.perf_counter() - rf_t0,
+        )
+
+    # ----- Load ADKF model -----
+    logger.info("Loading ADKF-IFT model from %s ...", args.adkf_checkpoint)
+    adkf_model = ADKTModelTrainer.build_from_model_file(
+        args.adkf_checkpoint, device=device
+    ).to(device)
+    adkf_model.eval()
+    use_numeric = adkf_model.config.use_numeric_labels
+    logger.info(
+        "ADKF model loaded (use_numeric_labels=%s).", use_numeric
+    )
+
+    # Reference standardisation (ADKF-style) for computing MPN/RF R2 in
+    # matching space.
+    log_y_query = np.log(y_query_nM)
+
+    # ----- Sweep -----
+    results: List[Dict[str, Any]] = []
+    for n in support_sizes:
+        support_samples = support_pool[:n]
+        y_support_nM = y_support_pool_nM[:n]
+        y_support_pic50_t = y_support_pool_pic50_t[:n]
+
+        # Per-n standardisation in log-nM space (same convention as
+        # baseline_numeric_test / mpn_test): use support-set stats to map both
+        # support labels and query labels to a shared standardized space.
+        log_y_support = np.log(y_support_nM)
+        std_mean = log_y_support.mean()
+        std_std = log_y_support.std()
+        y_query_std = (log_y_query - std_mean) / std_std
+
+        row: Dict[str, Any] = {"support_size": n}
+        log_parts: List[str] = []
+
+        # --- MPN timing(s) ---
+        for name, model in mpn_models.items():
+            support_pool_fps_t, query_fps_t = mpn_fp_cache[name]
+            support_fps_t = support_pool_fps_t[:n]
+
+            _call = partial(
+                mpn_fit_predict,
+                model,
+                support_fps_t,
+                query_fps_t,
+                y_support_pic50_t,
+            )
+            mean_s, median_s, std_s, preds_pic50 = _time_callable(
+                _call, device, args.repeats, warmup=args.warmup
+            )
+
+            preds_std = mpn_predictions_to_standardized_log(
+                preds_pic50, y_support_nM
+            )
+            r2 = compute_numeric_task_metrics(preds_std, y_query_std).r2
+
+            row[f"{name}_time_mean_s"] = mean_s
+            row[f"{name}_time_median_s"] = median_s
+            row[f"{name}_time_std_s"] = std_s
+            row[f"{name}_r2"] = r2
+            log_parts.append(
+                f"{name} {mean_s:.4f}s ± {std_s:.4f}"
+                f" (med {median_s:.4f}s, R2={r2:.3f})"
+            )
+
+        # --- Random-Forest timing ---
+        if args.rf:
+            assert rf_support_pool_X is not None and rf_query_X is not None
+            X_train_rf = rf_support_pool_X[:n]
+            # Standardize log-labels with the support-set's own stats, matching
+            # baseline_numeric_test.py.
+            y_train_std_rf = (np.log(y_support_nM) - std_mean) / std_std
+
+            _rf_call = partial(
+                rf_fit_predict,
+                X_train_rf,
+                rf_query_X,
+                y_train_std_rf,
+                RF_GRID_SEARCH,
+                args.rf_cv,
+                args.rf_jobs,
+            )
+            rf_mean, rf_median, rf_std, rf_preds = _time_callable(
+                _rf_call,
+                torch.device("cpu"),
+                args.rf_repeats,
+                warmup=0,
+            )
+            rf_r2 = compute_numeric_task_metrics(rf_preds, y_query_std).r2
+
+            row["rf_time_mean_s"] = rf_mean
+            row["rf_time_median_s"] = rf_median
+            row["rf_time_std_s"] = rf_std
+            row["rf_r2"] = rf_r2
+            log_parts.append(
+                f"RF {rf_mean:.4f}s ± {rf_std:.4f}"
+                f" (med {rf_median:.4f}s, R2={rf_r2:.3f})"
+            )
+
+        # --- ADKF timing ---
+        # Build DKT batch outside timing (equivalent to precomputing MPN FPs).
+        dkt_task_sample = build_adkf_batch(
+            support_samples=support_samples,
+            query_samples=query_samples,
+            task_name=task.name,
+            model=adkf_model,
+            use_numeric_labels=use_numeric,
+            max_batch_size=max(args.adkf_batch_size, n + len(query_samples)),
+        )
+
+        _adkf_call = partial(adkf_fit_predict, adkf_model, dkt_task_sample)
+        adkf_mean, adkf_median, adkf_std, adkf_r2 = _time_callable(
+            _adkf_call, device, args.repeats, warmup=args.warmup
+        )
+
+        row["adkf_time_mean_s"] = adkf_mean
+        row["adkf_time_median_s"] = adkf_median
+        row["adkf_time_std_s"] = adkf_std
+        row["adkf_r2"] = adkf_r2
+        log_parts.insert(
+            0,
+            f"ADKF {adkf_mean:.4f}s ± {adkf_std:.4f}"
+            f" (med {adkf_median:.4f}s, R2={adkf_r2:.3f})",
+        )
+
+        logger.info("n=%4d | %s", n, " | ".join(log_parts))
+        results.append(row)
+
+        # End-of-iteration cleanup: explicitly drop large per-iteration objects
+        # *before* the next iteration starts allocating its (larger) batch, so
+        # that two DKT batches don't coexist on the GPU during reassignment.
+        # We also ask the caching allocator to release blocks back to CUDA.
+        del dkt_task_sample
+        gc.collect()
+        if device.type == "cuda":
+            torch.cuda.empty_cache()
+
+    # ----- Save -----
+    if args.out:
+        # Stable column order: support_size first, then ADKF, then each MPN in
+        # the order they were configured, then RF.
+        ordered_keys: List[str] = ["support_size"]
+        for prefix in ["adkf"] + list(mpn_models.keys()) + (["rf"] if args.rf else []):
+            for suffix in ["time_mean_s", "time_median_s", "time_std_s", "r2"]:
+                col = f"{prefix}_{suffix}"
+                if col in results[0]:
+                    ordered_keys.append(col)
+        with open(args.out, "w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=ordered_keys)
+            writer.writeheader()
+            writer.writerows(results)
+        logger.info("Wrote %d rows to %s", len(results), args.out)
+
+    return results
+
+
+def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Compare ADKF-IFT vs MPN (AttMPN, KernelMPN) vs Random Forest"
+            " fit+predict wall-clock time on a single FS-Mol task as the"
+            " support-set size grows."
+        ),
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
+    )
+    parser.add_argument(
+        "data_path",
+        type=str,
+        help="Path to the *.jsonl.gz file describing a single FS-Mol task.",
+    )
+    parser.add_argument(
+        "adkf_checkpoint",
+        type=str,
+        help="Path to the ADKF-IFT checkpoint (*.pt).",
+    )
+    parser.add_argument(
+        "--kernel-mpn-checkpoint",
+        type=str,
+        default=None,
+        help=(
+            "Path to a KernelMPN checkpoint (*.pth). If omitted,"
+            " KernelMPN is skipped."
+        ),
+    )
+    parser.add_argument(
+        "--att-mpn-checkpoint",
+        type=str,
+        default=None,
+        help=(
+            "Path to an AttMPN checkpoint (*.pth). If omitted, AttMPN is"
+            " skipped."
+        ),
+    )
+    parser.add_argument(
+        "--rf",
+        action=argparse.BooleanOptionalAction,
+        default=True,
+        help=(
+            "Whether to time a Random-Forest baseline (with the same grid"
+            " search as baseline_numeric_test.py). Disable with --no-rf."
+        ),
+    )
+    parser.add_argument(
+        "--query-fraction",
+        type=float,
+        default=0.3,
+        help="Fraction of samples to hold out as a fixed query set.",
+    )
+    parser.add_argument(
+        "--max-query-size",
+        type=int,
+        default=None,
+        help=(
+            "Optional cap on the query-set size. Use this to keep the query"
+            " set small (e.g. 100) while the support pool grows to thousands."
+        ),
+    )
+    parser.add_argument(
+        "--step",
+        type=int,
+        default=10,
+        help=(
+            "Support-size increment for the sweep (ignored if"
+            " --support-size-schedule is given)."
+        ),
+    )
+    parser.add_argument(
+        "--max-support-size",
+        type=int,
+        default=None,
+        help=(
+            "Cap on the support size when using --step. Defaults to the full"
+            " support pool. Ignored if --support-size-schedule is given."
+        ),
+    )
+    parser.add_argument(
+        "--support-size-schedule",
+        type=int,
+        nargs="+",
+        default=None,
+        metavar="N",
+        help=(
+            "Explicit list of support sizes to evaluate, e.g."
+            " '--support-size-schedule 16 32 64 128 256 512 1024 2048'."
+            " Overrides --step / --max-support-size when provided. Entries"
+            " larger than the available support pool are silently dropped."
+        ),
+    )
+    parser.add_argument(
+        "--repeats",
+        type=int,
+        default=3,
+        help=(
+            "Number of timed repeats per support size for ADKF and the MPN"
+            " models (after --warmup discarded warm-up calls)."
+        ),
+    )
+    parser.add_argument(
+        "--warmup",
+        type=int,
+        default=1,
+        help=(
+            "Number of warm-up calls (per support size) before timing begins"
+            " for ADKF / MPN. Use a higher value if you see the first timed"
+            " run dominating the reported mean at small support sizes."
+        ),
+    )
+    parser.add_argument(
+        "--rf-repeats",
+        type=int,
+        default=1,
+        help=(
+            "Number of timed repeats for the Random-Forest baseline. Defaults"
