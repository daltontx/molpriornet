+++ b/fs_mol/tabicl_test.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Evaluate an off-the-shelf TabICL regressor on FS-Mol tasks.
+
+Mirrors ``tabpfn_test.py``, swapping TabPFN for TabICL. Like TabPFN, TabICL is a
+tabular foundation model trained on synthetic priors (not a chemistry-specific
+distribution), so no pIC50 conversion is applied: we fit on standardized
+``log(y)`` values, just like the sklearn baseline.
+"""
+import argparse
+import logging
+import sys
+
+import numpy as np
+from dpu_utils.utils import run_and_debug
+from pyprojroot import here as project_root
+from tabicl import TabICLRegressor
+
+sys.path.insert(0, str(project_root()))
+
+from fs_mol.data.fsmol_task import FSMolTaskSample
+from fs_mol.utils.chem_utils import compute_fingerprints
+from fs_mol.utils.metrics import NumericEvalMetrics, compute_numeric_task_metrics
+from fs_mol.utils.test_utils import (
+    eval_model,
+    add_eval_cli_args,
+    set_up_test_run,
+)
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_FINGERPRINT_SIZE = 500
+
+
+def test(
+    task_sample: FSMolTaskSample,
+    fp_size: int,
+    n_estimators: int,
+    batch_size: int,
+    device: str = None,
+    seed: int = 42,
+) -> NumericEvalMetrics:
+    train_data = task_sample.train_samples
+    test_data = task_sample.test_samples
+
+    X_train = compute_fingerprints([x.smiles for x in train_data], fp_size)
+    X_test = compute_fingerprints([x.smiles for x in test_data], fp_size)
+
+    y_train = np.array([float(x.numeric_label) for x in train_data])
+    y_test = np.array([float(x.numeric_label) for x in test_data])
+
+    # Match baseline_numeric_test.py / tabpfn_test.py: operate in standardized
+    # log-space. TabICL was trained on synthetic priors so no chemistry-specific
+    # (pIC50) transform is needed — standardization is enough to keep the target
+    # well-scaled. (TabICL also standardizes y internally, but we keep the
+    # transform here so the reported metrics are on the same scale as the other
+    # numeric evaluations.)
+    log_y_train = np.log(y_train)
+    log_y_test = np.log(y_test)
+    standardize_mean = log_y_train.mean()
+    standardize_std = log_y_train.std()
+
+    log_y_train_standardized = (log_y_train - standardize_mean) / standardize_std
+    log_y_test_standardized = (log_y_test - standardize_mean) / standardize_std
+
+    logger.info(f" Evaluating TabICL with {X_train.shape[0]} training samples.")
+
+    model = TabICLRegressor(
+        n_estimators=n_estimators,
+        batch_size=batch_size,
+        device=device,
+        random_state=seed,
+    )
+    model.fit(X_train, log_y_train_standardized)
+    preds_standardized = model.predict(X_test)
+
+    test_metrics = compute_numeric_task_metrics(preds_standardized, log_y_test_standardized)
+    logger.info(f" Test metrics: {test_metrics}")
+
+    return test_metrics
+
+
+def run_from_args(args) -> None:
+    out_dir, dataset = set_up_test_run("TabICL", args)
+
+    def test_model_fn(
+        task_sample: FSMolTaskSample, temp_out_folder: str, seed: int
+    ) -> NumericEvalMetrics:
+        return test(
+            task_sample=task_sample,
+            fp_size=args.fingerprint_size,
+            n_estimators=args.n_estimators,
+            batch_size=args.batch_size,
+            device=args.device,
+            seed=seed,
+        )
+
+    eval_model(
+        test_model_fn=test_model_fn,
+        dataset=dataset,
+        train_set_sample_sizes=args.train_sizes,
+        out_dir=out_dir,
+        num_samples=args.num_runs,
+        test_size_or_ratio=args.test_size,
+        seed=args.seed,
+        filter_numeric_labels=True,
+    )
+
+
+def run():
+    parser = argparse.ArgumentParser(
+        description="Evaluate an off-the-shelf TabICL regressor on FS-Mol tasks.",
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
+    )
+
+    add_eval_cli_args(parser)
+
+    parser.add_argument(
+        "--fingerprint-size",
+        type=int,
+        default=DEFAULT_FINGERPRINT_SIZE,
+        help=(
+            "Morgan fingerprint length fed to TabICL. Unlike TabPFN, TabICL has no"
+            " hard feature-count limit, but the default matches tabpfn_test.py so"
+            " the two are directly comparable."
+        ),
+    )
+    parser.add_argument(
+        "--n-estimators",
+        type=int,
+        default=8,
+        help="Number of ensemble members (dataset views) TabICL averages over.",
+    )
+    parser.add_argument(
+        "--batch-size",
+        type=int,
+        default=2,
+        help=(
+            "How many ensemble members TabICL processes at once. This is the dominant"
+            " memory knob: peak usage is driven by a column-embedding tensor of shape"
+            " (batch_size, n_train + n_test, fingerprint_size, 128) in float32, so the"
+            " library default of 8 needs ~7 GB on the largest FS-Mol tasks. Lowering it"
+            " trades speed for memory and leaves predictions unchanged."
+        ),
+    )
+    parser.add_argument(
+        "--device",
+        type=str,
+        default=None,
+        help=(
+            "Torch device for inference ('cuda', 'cpu', 'mps'). Defaults to CUDA if"
+            " available, otherwise CPU; MPS must be requested explicitly."
+        ),
+    )
+    parser.add_argument("--debug", dest="debug", action="store_true", help="Enable debug routines")
+
+    args = parser.parse_args()
+    run_and_debug(lambda: run_from_args(args), args.debug)
+
+
+if __name__ == "__main__":
+    run()
